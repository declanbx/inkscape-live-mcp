<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Claude bridge</name>
  <id>org.inkscape.claude.bridge</id>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Claude"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">claude_bridge.py</command>
  </script>
</inkscape-extension>
